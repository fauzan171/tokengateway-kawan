# Salinan template. Semua nilai di sini PALSU. Jangan isi kredensial nyata.
# Nama rahasia tidak pernah memakai awalan NEXT_PUBLIC_.

# Dev: SQLite. Prod: PostgreSQL.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://kawan:kawan@localhost:5432/kawan"

# Kunci AES-256-GCM. WAJIB: 32 byte setelah decode base64.
# Isi dengan hasil `openssl rand -base64 32`. Aplikasi gagal start bila kosong
# atau panjangnya salah.
ENCRYPTION_SECRET=""

# Kunci penandatanganan cookie sesi Auth.js. WAJIB, panjang bebas.
# Isi dengan hasil `openssl rand -base64 32`. Aplikasi gagal start bila kosong.
AUTH_SECRET=""

# Masa berlaku tautan reset kata sandi, dalam detik. Bawaan: 3600 (60 menit).
# PASSWORD_RESET_TTL_SECONDS=3600

# Penanda email dikonfigurasi operator. PENGIRIMAN EMAIL BELUM DIBANGUN DI v1:
# tidak ada pesan yang benar-benar dikirim. Mengisi salah satu di bawah hanya
# memberi tahu alur reset bahwa tautan TIDAK perlu ditulis ke log admin.
# KAWAN_SMTP_URL=
# SMTP_HOST=

# ID kunci untuk envelope dan rotasi (SDD-5.2). Bawaan: "v1". Envelope
# menyimpan ID ini sehingga ciphertext lama tetap terbaca setelah kunci
# berganti. Rotasi: tambah keyId baru, deploy, re-enkripsi bertahap, baru
# pensiunkan yang lama. Lihat src/lib/secrets/README.md.
# ENCRYPTION_KEY_ID=v1

# Masa berlaku cache daftar model, dalam detik. Bawaan: 600 (10 menit).
# MODEL_CACHE_TTL_SECONDS=600

# Allowlist tujuan keluar untuk gateway privat on-premise (SDD-5.3).
# Dipisah koma, host atau host:port presisi, tanpa wildcard. Kosong berarti
# seluruh rentang privat tetap ditolak.
# OUTBOUND_ALLOWLIST=10.0.0.5:8080,gateway.internal

# Mengizinkan baseUrl http:// tanpa TLS. Bawaan: false (hanya https).
# Menyalakan ini melonggarkan keamanan secara sadar; hanya untuk jaringan lokal.
# ALLOW_INSECURE_HTTP=false

# Akar penyimpanan berkas dokumen (SDD-6.1). WAJIB di luar `public/`.
# Bawaan: <project>/.data/documents. Berkas disimpan dengan nama acak.
# STORAGE_LOCAL_DIR=

# Batas ukuran berkas dokumen yang boleh diunggah, dalam byte (REQ-NT-60).
# Bawaan: 10485760 (10 MB). Penolakan menyebut batas ini.
# MAX_UPLOAD_BYTES=10485760

# Belum dipakai; ditambahkan bersama paket yang memakainya (SDD-1.5).
# KAWAN_APP_URL=
# KAWAN_VERSION=
# KAWAN_REPO_URL=
# STORAGE_DRIVER=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# MAX_UPLOAD_BYTES=

# Pencarian web opsional (REQ-NT-51). Kosongkan untuk menyembunyikan tombol.
# Protokol: SearXNG JSON API (`GET {baseUrl}/search?format=json`).
# WEBSEARCH_BASE_URL=
# WEBSEARCH_API_KEY=
# WEBSEARCH_LIMIT=5

# Media opsional (REQ-NT-65/67/68). Kosongkan untuk menyembunyikan kontrolnya.
# Nama model diteruskan apa adanya ke gateway pada koneksi aktif pengguna.
# MEDIA_IMAGE_MODEL=
# MEDIA_STT_MODEL=
# MEDIA_TTS_MODEL=
# MEDIA_TTS_VOICE=
