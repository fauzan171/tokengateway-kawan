# Salinan template. Semua nilai di sini PALSU. Jangan isi kredensial nyata.
# Nama rahasia tidak pernah memakai awalan NEXT_PUBLIC_.

# Dev: SQLite. Prod: PostgreSQL.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://kawan:kawan@localhost:5432/kawan"

# Kunci AES-256-GCM. WAJIB: 32 byte setelah decode base64.
# Isi dengan hasil `openssl rand -base64 32`. Aplikasi gagal start bila kosong
# atau panjangnya salah.
ENCRYPTION_SECRET=""

# Kunci penandatanganan cookie sesi Auth.js. WAJIB, panjang bebas.
# Isi dengan hasil `openssl rand -base64 32`. Aplikasi gagal start bila kosong.
AUTH_SECRET=""

# Masa berlaku tautan reset kata sandi, dalam detik. Bawaan: 3600 (60 menit).
# PASSWORD_RESET_TTL_SECONDS=3600

# Penanda email dikonfigurasi operator. PENGIRIMAN EMAIL BELUM DIBANGUN DI v1:
# tidak ada pesan yang benar-benar dikirim. Mengisi salah satu di bawah hanya
# memberi tahu alur reset bahwa tautan TIDAK perlu ditulis ke log admin.
# KAWAN_SMTP_URL=
# SMTP_HOST=

# Belum dipakai; ditambahkan bersama paket yang memakainya (SDD-1.5).
# ENCRYPTION_KEY_ID=
# KAWAN_APP_URL=
# KAWAN_VERSION=
# KAWAN_REPO_URL=
# STORAGE_DRIVER=
# STORAGE_LOCAL_DIR=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# WEBSEARCH_BASE_URL=
# WEBSEARCH_API_KEY=
# MAX_UPLOAD_BYTES=
