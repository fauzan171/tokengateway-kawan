{
  "name": "kawan",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "node scripts/make-sqlite-schema.mjs && prisma generate && prisma generate --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:docs": "python3 tasks/nontechnical-v1/tools/check_docs.py",
    "check:licenses": "node scripts/check-licenses.mjs",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "deploy": "next build && pm2 restart kawan kawan-worker --update-env"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "decimal.js": "^10.6.0",
    "docx": "^9.13.0",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "next": "15.5.27",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
