// Schema sumber kebenaran untuk Kawan.
//
// Satu schema, dua provider. Karena `datasource.provider` di Prisma bersifat
// statis, nilai di bawah menunjuk ke provider PRODUKSI (PostgreSQL); SQLite
// hanya dipakai untuk dev dan uji. Agar migrasi yang sama jalan di keduanya,
// seluruh migration.sql ditulis dengan subset SQL portabel (lihat
// prisma/migrations/*/migration.sql) dan tidak boleh memakai tipe atau
// konstruksi yang hanya ada di satu provider.
//
// Provider yang benar-benar dipakai saat runtime ditentukan DATABASE_URL,
// bukan oleh baris ini.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Akun pengguna Kawan. Email disimpan sudah lowercase dan ternormalisasi.
model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      String   @default("user") // user | admin
  status    String   @default("pending") // pending | active | disabled
  createdAt DateTime @default(now())

  credential Credential?
  sessions   Session[]
  passwordResetTokens PasswordResetToken[]
  connections Connection[]
  chats     Chat[]
  folders   Folder[]
  documents Document[]
  chatDocs  ChatDocument[]
  artifacts Artifact[]
  prompts   Prompt[]
  setting   UserSetting?
  tasks     Task[]
  memories  MemoryItem[]
  connectors ConnectorCredential[]
  schedules Schedule[]
  notifications Notification[]

  @@index([status])
}

/// Rahasia kredensial, dipisah dari User mengikuti pola baseline user/auth.
model Credential {
  userId       String   @id
  passwordHash String // Argon2id
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Antrean job berbasis tabel (SDD-8). Tidak ada Redis di v1.
///
/// Klaim memakai UPDATE bersyarat `state='queued'`; jumlah baris terpengaruh 0
/// berarti job sudah diklaim pihak lain. Lease dijaga heartbeat dan boleh
/// kedaluwarsa, supaya worker yang mati tidak menyandera job.
model Job {
  id             String    @id
  kind           String
  payloadJson    String
  state          String    @default("queued") // queued | leased | running | succeeded | failed | cancelled | indeterminate
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  availableAt    DateTime  @default(now())
  leaseOwner     String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([state, availableAt])
  @@index([leaseExpiresAt])
}

/// Percobaan login gagal untuk pembatas laju berbasis tabel (REQ-NT-15, SDD-5.1).
///
/// Hitungan sengaja disimpan di database, bukan di memori proses: dengan
/// begitu ia bertahan setelah restart dan terlihat oleh setiap proses yang
/// memakai database yang sama. `key` adalah email ternormalisasi ditambah hash
/// alamat IP — alamat IP mentah tidak pernah disimpan. Baris kedaluwarsa
/// dibuang oleh `pruneAttempts`, bukan oleh timer proses.
model LoginAttempt {
  id        String   @id
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// Token reset kata sandi sekali pakai (REQ-NT-16, SDD-5.1).
///
/// Yang disimpan hanya SHA-256 dari token acak; token mentah dikembalikan
/// sekali ke pemanggil dan tidak pernah ditulis ke database. Pemakaian kedua
/// ditolak lewat `usedAt`, dan kedaluwarsa dihitung dari `expiresAt` di DATA,
/// bukan dari timer proses. Masa berlaku diatur env (lihat `env.ts`).
model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Koneksi gateway milik pengguna (REQ-NT-17, SDD-2.2).
///
/// KONTRAK DIBEKUKAN di akhir NT-P2: NT-P2 dan NT-P3 berbagi bentuk ini.
/// Mengubahnya setelah NT-P3 mulai memaksa penulisan ulang pemilih model.
///
/// `apiKeyEncrypted` adalah envelope AES-256-GCM (SDD-5.2) dan TIDAK PERNAH
/// keluar dari `lib/secrets`/`lib/connections` — tidak ke respons API, log,
/// ekspor, maupun snapshot berbagi (REQ-NT-07).
///
/// `apiKeyMask` disimpan, bukan dihitung saat dibaca: SDD-5.2 melarang
/// mendekripsi hanya untuk membuat mask pada operasi daftar.
///
/// `isActive` memakai Int 0/1, bukan Boolean: migrasi harus portabel untuk
/// SQLite dan PostgreSQL, dan `BOOLEAN` ditolak oleh `check-migrations.mjs`.
model Connection {
  id              String   @id
  userId          String
  name            String
  baseUrl         String
  apiKeyEncrypted String
  apiKeyMask      String
  keyId           String
  isActive        Int      @default(0) // 0 | 1
  status          String   @default("draft") // draft | active | error
  /// FIX-05: dinaikkan setiap kali konfigurasi koneksi berubah. Generasi yang
  /// dipin ke revisi lama tidak boleh diam-diam memakai kredensial baru.
  revision        Int      @default(1)
  lastTestAt      DateTime?
  lastTestStatus  String?
  createdAt       DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelCache ModelCache?

  @@index([userId])
  @@index([userId, isActive])
}

/// Cache daftar model per koneksi (REQ-NT-20, SDD-3.3).
///
/// Satu baris per koneksi (relasi unik). TTL diperiksa dari `fetchedAt` di
/// DATA, bukan dari timer proses, supaya cache tidak menahan model baru
/// melewati masa berlakunya setelah restart.
model ModelCache {
  id            String   @id
  connectionId  String
  modelListJson String
  fetchedAt     DateTime

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId])
}


/// Dokumen milik pengguna untuk tanya-jawab berbasis berkas (REQ-NT-54, SDD-6.1).
///
/// `filename` adalah nama asli yang sudah disanitasi, hanya untuk tampilan.
/// Berkasnya sendiri disimpan di luar webroot dengan nama acak; `storageKey`
/// adalah path relatif terhadap akar penyimpanan, bukan path absolut dan bukan
/// nama dari pengguna. Status: queued | processing | ready | failed.
model Document {
  id         String   @id
  userId     String
  filename   String
  mime       String
  sizeBytes  Int
  storageKey String
  status     String   @default("queued")
  errorCode  String?
  createdAt  DateTime @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]
  chatDocs   ChatDocument[]

  @@index([userId, createdAt])
  @@index([status])
}

/// Manifest dokumen yang dilampirkan ke satu chat (FIX-06).
///
/// Retrieval hanya memakai dokumen di manifest chat itu, bukan semua dokumen
/// pengguna. `documentId` restrict: dokumen yang masih direferensikan chat
/// tidak ikut terhapus tanpa sengaja — penghapusan dokumen lewat
/// `removeDocument` yang membersihkan manifest lebih dulu.
model ChatDocument {
  id         String   @id
  chatId     String
  documentId String
  ownerId    String
  addedAt    DateTime @default(now())

  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([chatId, documentId])
  @@index([chatId])
}

/// Potongan teks satu dokumen (REQ-NT-55, SDD-6.1).
///
/// `page` dan `section` menyimpan metadata sumber untuk sitasi (REQ-NT-57).
/// `embedding` disimpan sebagai teks base64, bukan `Bytes`: migrasi harus
/// identik di SQLite dan PostgreSQL, dan `BLOB`/`BYTEA` ditolak
/// `scripts/check-migrations.mjs`. Vektor ditulis oleh job `document.embed`.
model DocumentChunk {
  id         String   @id
  documentId String
  ordinal    Int
  text       String
  page       Int?
  section    String?
  embedding  String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([documentId])
}

/// Berkas yang dibuat asisten atau pengguna (FIX-11, SDD Artifact).
///
/// Byte berkas ada di storage adapter existing (`lib/documents/storage.ts`);
/// baris ini hanya metadata + rujukan `storageKey`. `format` menentukan cara
/// byte dibuat, `mime` menentukan header unduhan — keduanya disimpan supaya
/// berkas lama tetap dapat diunduh walau daftar format berubah.
model Artifact {
  id          String   @id
  userId      String
  chatId      String?
  messageId   String?
  /// md | txt | json | csv | xlsx | docx | pdf | html | zip
  format      String
  /// Nama tampilan yang sudah dibersihkan; TIDAK pernah dipakai sebagai path.
  displayName String
  mime        String
  sizeBytes   Int
  sha256      String
  storageKey  String
  /// staged | ready | failed
  status      String   @default("staged")
  errorCode   String?
  errorMessage String?
  /// Turunan versi: id artefak sumber saat ini dibuat ulang/dikonversi.
  parentArtifactId String?
  /// Nomor versi dalam rantai lineage; akar = 1, anak = parent.version + 1.
  version     Int      @default(1)
  /// JSON provenance: { schemaVersion, source, notes }
  provenance  String?
  downloadCount Int    @default(0)
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([chatId])
  @@index([status])
}

/// Folder satu tingkat untuk mengelompokkan chat (REQ-NT-35, SDD-2.2).
model Folder {
  id        String   @id
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats Chat[]

  @@index([userId])
}

/// Percakapan (REQ-NT-22, SDD-2.2). KONTRAK DIBEKUKAN di awal NT-P3.
///
/// `currentMessageId` menunjuk leaf aktif pohon pesan; harus menunjuk pesan yang ada
/// atau null (SDD-2.4). `modelRef` menyimpan id model yang dipakai chat ini, bukan
/// global (REQ-NT-19); menghapus koneksi TIDAK menghapus chat (REQ-NT-09).
model Chat {
  id               String   @id
  userId           String
  title            String
  /// "manual" setelah pengguna mengganti judul; "auto" sesudah derivasi.
  /// Judul otomatis tidak boleh menimpa judul manual (FIX-04).
  titleSource      String   @default("auto")
  titleRevision    Int      @default(0)
  modelRef         String?
  currentMessageId String?
  folderId         String?
  pinned           Int      @default(0) // 0 | 1
  archived         Int      @default(0) // 0 | 1
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]
  shareLinks ShareLink[]
  chatDocs   ChatDocument[]
  memories   MemoryItem[]

  @@index([userId, updatedAt])
  @@index([userId, folderId])
}

/// Tautan berbagi snapshot beku publik (REQ-NT-36/37/38, SDD-2.2).
model ShareLink {
  id           String    @id
  chatId       String
  token        String    @unique
  snapshotJson String
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

/// Satu pesan dalam pohon (REQ-NT-25, SDD-2.2).
///
/// `parentId` membentuk pohon; sibling = cabang alternatif dari parent yang sama.
/// `seq` memberi urutan stabil dalam satu chat. `contentJson` menyimpan bagian
/// bertipe agar render tidak menebak.
model ChatMessage {
  id          String   @id
  chatId      String
  parentId    String?
  role        String // user | assistant | system
  contentJson String
  status      String   @default("complete") // streaming | complete | stopped | error
  usageJson   String?
  seq         Int
  createdAt   DateTime @default(now())

  chat       Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  parts      ChatMessagePart[]
  generation Generation?

  @@index([chatId, seq])
  @@index([chatId, parentId])
}

/// Bagian bertipe dari satu pesan (SDD-2.2): text | tool | image | citation.
model ChatMessagePart {
  id          String @id
  messageId   String
  kind        String
  payloadJson String
  ordinal     Int

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, ordinal])
}

/// Generasi = pekerjaan berdurasi, bukan milik koneksi HTTP (SDD-4.1).
///
/// State: queued | preparing | streaming | complete | stopped | error | indeterminate.
/// `indeterminate` TIDAK diulang otomatis — UI menawarkan coba lagi manual, supaya
/// tidak menggandakan permintaan berbayar (SDD-4.2).
model Generation {
  id                String    @id
  chatId            String
  userMessageId     String
  assistantMessageId String    @unique
  jobId             String?
  /// FIX-05: koneksi dan model dipin saat admission. NULL = baris lama sebelum
  /// pinning ada; worker jatuh ke koneksi aktif seperti sebelumnya.
  connectionId      String?
  modelId           String?
  /// FIX-05: revisi konfigurasi koneksi saat admission. Worker menolak jalan
  /// bila `Connection.revision` sudah bergeser.
  connectionRevision Int?
  status            String    @default("queued")
  cancelRequestedAt DateTime?
  errorCode         String?
  finishReason      String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())

  assistantMessage ChatMessage       @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)
  events           GenerationEvent[]

  @@index([chatId, createdAt])
  @@index([status])
}

/// Buffer event SSE untuk pemutaran ulang setelah koneksi putus (SDD-4.5).
/// `seq` monoton per generasi; klien menyambung ulang dengan afterSeq=lastSeq.
model GenerationEvent {
  id           String   @id
  generationId String
  seq          Int
  kind         String // meta | part | usage | done | error
  payloadJson  String
  createdAt    DateTime @default(now())

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, seq])
}

/// Prompt tersimpan (REQ-NT-62/63/64). `userId` null = prompt bawaan admin.
model Prompt {
  id            String   @id
  userId        String?
  title         String
  body          String
  variablesJson String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

/// Catatan pemakaian token (REQ-NT-71, SDD-2.2).
/// `reported` = 0 bila gateway tidak melaporkan usage — jangan diisi angka karangan.
model UsageRecord {
  id               String   @id
  userId           String
  chatId           String?
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  reported         Int      @default(1) // 0 | 1
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

/// Kunci idempotensi untuk POST pesan (SDD-4.7).
/// Kunci sama + digest sama → hasil sama; digest berbeda → 409. Unik per pengguna.
model IdempotencyKey {
  id           String   @id
  userId       String
  key          String
  digest       String
  responseJson String
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

/// Sesi untuk pencabutan. Token mentah tidak pernah disimpan.
model Session {
  id            String    @id
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  userAgentHash String?
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Memori eksplisit milik pengguna (FIX-13).
///
/// Bukan riwayat chat, bukan ringkasan otomatis: hanya butir yang disimpan
/// karena pengguna memintanya (`consent: "explicit"`) atau usulan yang menunggu
/// tinjauan (`consent: "proposed"`). Versi lama tidak dihapus saat dikoreksi —
/// `status: "superseded"` + `parentId` menyimpan rantai koreksi.
model MemoryItem {
  id             String    @id
  userId         String
  /// "global" (lintas chat) atau "chat" (hanya `chatId` itu).
  scope          String    @default("global")
  chatId         String?
  /// "preference" | "fact" | "instruction"
  category       String
  text           String
  /// "active" | "proposed" | "revoked" | "superseded"
  status         String    @default("active")
  /// "explicit" | "proposed"
  consent        String    @default("explicit")
  version        Int       @default(1)
  parentId       String?
  /// Dari mana butir ini berasal: "message" | "document" | "manual".
  sourceKind     String?
  sourceRef      String?
  /// Revisi sumber saat butir disimpan; sumber berubah → provenance tidak lagi
  /// membuktikan butir yang sama.
  sourceRevision Int?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat       Chat?            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  parent     MemoryItem?      @relation("MemoryVersion", fields: [parentId], references: [id])
  revisions  MemoryItem[]     @relation("MemoryVersion")
  derived    MemoryDependency[] @relation("MemoryDependencyOwner")
  dependsOn  MemoryDependency[] @relation("MemoryDependencyTarget")

  @@index([userId, status])
  @@index([userId, chatId])
  @@index([parentId])
}

/// Ringkasan/cache turunan dari satu atau beberapa memori (FIX-13).
/// Mencabut `targetId` menggugurkan semua baris yang bergantung padanya.
model MemoryDependency {
  id        String   @id
  memoryId  String
  targetId  String
  /// "summary" | "cache" | "vector"
  kind      String   @default("summary")
  createdAt DateTime @default(now())

  memory MemoryItem @relation("MemoryDependencyOwner", fields: [memoryId], references: [id], onDelete: Cascade)
  target MemoryItem @relation("MemoryDependencyTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([memoryId, targetId])
  @@index([targetId])
}

/// Preferensi tampilan dan kirim (REQ-NT-70). Satu baris per pengguna.
model UserSetting {
  userId       String   @id
  theme        String   @default("system") // system | light | dark
  locale       String   @default("id")     // id | en
  fontScale    Int      @default(100)      // 90..130
  sendOnEnter  Int      @default(1)        // 1 = Enter kirim, 0 = Shift+Enter kirim
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Denyut proses worker (FIX-24, SDD-8.5).
///
/// Sebelumnya status worker disimpulkan dari `Job.heartbeatAt`; worker yang
/// sehat tetapi antrean kosong karena itu tampak mati. Baris ini ditulis
/// worker idle setiap beberapa detik, jadi kesegarannya membuktikan proses
/// hidup — bukan keberadaan job.
model WorkerHeartbeat {
  workerId     String   @id
  version      String
  capabilities String   @default("[]")
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime

  @@index([lastSeenAt])
}

/// Konfigurasi runtime yang dapat diubah admin (REQ-NT-76). Satu baris, id = "app".
/// Baris tidak ada = pendaftaran terbuka; jangan menyisipkan baris saat membaca.
model AppConfig {
  id               String   @id
  registrationOpen Int      @default(1) // 0 | 1
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Task persisten (FIX-08, SDD-AG-2).
//
// Kepemilikan selalu lewat `Task.userId`; child row tidak dipercaya hanya karena
// punya id. `deletedAt` adalah tombstone: daftar/detail menyembunyikannya, tetapi
// cancel/terminalisasi masih boleh menulis metadata penghentian.
// ---------------------------------------------------------------------------

/// Tujuan pengguna yang dikerjakan agen, terpisah dari pohon Chat.
///
/// `activeRunId` adalah pointer tervalidasi ke run segment terbaru, bukan FK:
/// run lama tetap boleh ada setelah terminalization.
model Task {
  id          String    @id
  userId      String
  title       String
  /// active | archived
  status      String    @default("active")
  activeRunId String?
  revision    Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs     TaskRun[]
  messages TaskMessage[]

  @@index([userId, status, updatedAt, id])
}

/// Satu segmen eksekusi sebuah task.
///
/// `segment` bertambah saat run menunggu input/approval lalu dilanjutkan lewat
/// job baru; run lama tidak berwenang menulis lagi (currentJobId menunjuk yang
/// terbaru). `lastEventSeq` dialokasikan server di dalam transaksi yang menulis
/// event, bukan dari `max(seq)+1` di luar transaksi.
model TaskRun {
  id                 String    @id
  taskId             String
  segment            Int       @default(1)
  /// queued | running | waiting_input | waiting_approval | completed | failed |
  /// cancelled | indeterminate
  status             String    @default("queued")
  revision           Int       @default(1)
  connectionId       String?
  modelId            String    @default("")
  /// Pointer tervalidasi ke TaskMessage; unik supaya satu pesan tidak dipakai
  /// dua run. Bukan FK agar pesan tidak ikut terhapus saat run dipangkas.
  inputMessageId     String?   @unique
  assistantMessageId String?   @unique
  currentJobId       String?   @unique
  lastEventSeq       Int       @default(0)
  stepCount          Int       @default(0)
  deadlineAt         DateTime
  waitingExpiresAt   DateTime?
  cancelRequestedAt  DateTime?
  errorCode          String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime  @default(now())

  task     Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  events   TaskEvent[]
  messages TaskMessage[]
  interactions TaskInteraction[]

  @@index([taskId, createdAt, id])
  @@index([status, deadlineAt])
}

/// Percakapan linear tugas. Riwayat Chat tidak dimigrasikan diam-diam.
model TaskMessage {
  id         String   @id
  taskId     String
  runId      String?
  /// user | assistant
  role       String
  text       String
  requestKey String?
  createdAt  DateTime @default(now())

  task Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run  TaskRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([runId, role])
  @@index([taskId, createdAt, id])
}

/// Kredensial konektor pihak ketiga (FIX-20).
///
/// Token selalu tersimpan sebagai envelope AES-GCM dengan AAD
/// `{rowId, userId, purpose:"connector.token"}`, jadi ciphertext satu baris
/// tidak dapat dipakai di baris lain. Token TIDAK PERNAH keluar dari modul
/// `lib/connectors` menuju model, sandbox, log, ekspor, atau snapshot.
model ConnectorCredential {
  id             String    @id
  userId         String
  /// google-drive | notion
  provider       String
  /// Nama tampilan yang dipilih pengguna ("Drive kerja").
  label          String
  /// Scope OAuth yang benar-benar diberikan, dipisah spasi.
  scopes         String    @default("")
  tokenEncrypted String
  /// Refresh token terpisah; dikosongkan bila provider tidak menerbitkannya.
  refreshEncrypted String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([userId, revokedAt])
}

/// Jadwal berulang atau sekali jalan (FIX-21).
///
/// `nextRunAt` disimpan dalam UTC; `localTime` + `timezone` (IANA) adalah
/// sumber aturan, bukan offset tulisan tangan. Sweeper menghitung ulang, jadi
/// restart proses tidak menggeser jadwal dan DST tidak menggandakan occurrence.
model Schedule {
  id             String    @id
  userId         String
  title          String
  prompt         String
  /// Waktu lokal "YYYY-MM-DDTHH:mm" di zona `timezone`.
  localTime      String
  timezone       String
  /// null | daily | weekly
  recurrence     String?
  /// skip | run — bawaan skip untuk aksi berbiaya/eksternal.
  misfirePolicy  String    @default("skip")
  /// read | write — write butuh approval per occurrence.
  effect         String    @default("read")
  /// Int 0/1 (portabel SQLite+PostgreSQL), bukan Boolean — lihat chats.ts.
  enabled        Int       @default(1)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  policyRevision Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences ScheduleOccurrence[]

  @@index([enabled, nextRunAt])
  @@index([userId, createdAt])
}

/// Satu kejadian jadwal. Unik per (schedule, waktu): dua scheduler tidak dapat
/// membuat dua occurrence untuk waktu yang sama.
model ScheduleOccurrence {
  id           String    @id
  scheduleId   String
  scheduledFor DateTime
  /// pending | dispatched | skipped | cancelled
  status       String    @default("pending")
  jobId        String?
  createdAt    DateTime  @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledFor])
  @@index([status, createdAt])
}

/// Notifikasi dalam aplikasi (FIX-21). Outbox durable, bukan push.
model Notification {
  id        String    @id
  userId    String
  kind      String
  title     String
  body      String
  /// Isi sensitif tidak ditampilkan di notifikasi sistem/lockscreen.
  /// Int 0/1 (portabel SQLite+PostgreSQL).
  sensitive Int       @default(0)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Stream event durable sebuah run. `seq` unik per run; SSE menyusulnya.
model TaskEvent {
  id          String   @id
  runId       String
  seq         Int
  kind        String
  payloadJson String
  createdAt   DateTime @default(now())

  run TaskRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, createdAt])
}

/// Permintaan input/persetujuan yang menunggu jawaban pengguna.
///
/// Konsumsi memakai CAS `status=pending` + expiresAt + revision, jadi jawaban
/// yang basi (expired/terjawab) ditolak 409, bukan diterapkan dua kali.
model TaskInteraction {
  id          String    @id
  runId       String
  /// input | approval | handover
  kind        String
  /// pending | accepted | rejected | expired | cancelled
  status      String    @default("pending")
  revision    Int       @default(1)
  promptJson  String
  expiresAt   DateTime
  answerJson  String?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  run TaskRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([expiresAt, status])
}
