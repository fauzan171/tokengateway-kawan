// Schema sumber kebenaran untuk Kawan.
//
// Satu schema, dua provider. Karena `datasource.provider` di Prisma bersifat
// statis, nilai di bawah menunjuk ke provider PRODUKSI (PostgreSQL); SQLite
// hanya dipakai untuk dev dan uji. Agar migrasi yang sama jalan di keduanya,
// seluruh migration.sql ditulis dengan subset SQL portabel (lihat
// prisma/migrations/*/migration.sql) dan tidak boleh memakai tipe atau
// konstruksi yang hanya ada di satu provider.
//
// Provider yang benar-benar dipakai saat runtime ditentukan DATABASE_URL,
// bukan oleh baris ini.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Akun pengguna Kawan. Email disimpan sudah lowercase dan ternormalisasi.
model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      String   @default("user") // user | admin
  status    String   @default("pending") // pending | active | disabled
  createdAt DateTime @default(now())

  credential Credential?
  sessions   Session[]
  passwordResetTokens PasswordResetToken[]
  chats     Chat[]
  folders   Folder[]
  connections Connection[]
  documents Document[]
  prompts   Prompt[]
  setting   UserSetting?

  @@index([status])
}

/// Rahasia kredensial, dipisah dari User mengikuti pola baseline user/auth.
model Credential {
  userId       String   @id
  passwordHash String // Argon2id
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Antrean job berbasis tabel (SDD-8). Tidak ada Redis di v1.
///
/// Klaim memakai UPDATE bersyarat `state='queued'`; jumlah baris terpengaruh 0
/// berarti job sudah diklaim pihak lain. Lease dijaga heartbeat dan boleh
/// kedaluwarsa, supaya worker yang mati tidak menyandera job.
model Job {
  id             String    @id
  kind           String
  payloadJson    String
  state          String    @default("queued") // queued | leased | running | succeeded | failed | cancelled | indeterminate
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  availableAt    DateTime  @default(now())
  leaseOwner     String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([state, availableAt])
  @@index([leaseExpiresAt])
}

/// Percobaan login gagal untuk pembatas laju berbasis tabel (REQ-NT-15, SDD-5.1).
///
/// Hitungan sengaja disimpan di database, bukan di memori proses: dengan
/// begitu ia bertahan setelah restart dan terlihat oleh setiap proses yang
/// memakai database yang sama. `key` adalah email ternormalisasi ditambah hash
/// alamat IP — alamat IP mentah tidak pernah disimpan. Baris kedaluwarsa
/// dibuang oleh `pruneAttempts`, bukan oleh timer proses.
model LoginAttempt {
  id        String   @id
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// Token reset kata sandi sekali pakai (REQ-NT-16, SDD-5.1).
///
/// Yang disimpan hanya SHA-256 dari token acak; token mentah dikembalikan
/// sekali ke pemanggil dan tidak pernah ditulis ke database. Pemakaian kedua
/// ditolak lewat `usedAt`, dan kedaluwarsa dihitung dari `expiresAt` di DATA,
/// bukan dari timer proses. Masa berlaku diatur env (lihat `env.ts`).
model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Koneksi gateway milik pengguna (REQ-NT-17, SDD-2.2).
///
/// KONTRAK DIBEKUKAN di akhir NT-P2: NT-P2 dan NT-P3 berbagi bentuk ini.
/// Mengubahnya setelah NT-P3 mulai memaksa penulisan ulang pemilih model.
///
/// `apiKeyEncrypted` adalah envelope AES-256-GCM (SDD-5.2) dan TIDAK PERNAH
/// keluar dari `lib/secrets`/`lib/connections` — tidak ke respons API, log,
/// ekspor, maupun snapshot berbagi (REQ-NT-07).
///
/// `apiKeyMask` disimpan, bukan dihitung saat dibaca: SDD-5.2 melarang
/// mendekripsi hanya untuk membuat mask pada operasi daftar.
///
/// `isActive` memakai Int 0/1, bukan Boolean: migrasi harus portabel untuk
/// SQLite dan PostgreSQL, dan `BOOLEAN` ditolak oleh `check-migrations.mjs`.
model Connection {
  id              String   @id
  userId          String
  name            String
  baseUrl         String
  apiKeyEncrypted String
  apiKeyMask      String
  keyId           String
  isActive        Int      @default(0) // 0 | 1
  status          String   @default("draft") // draft | active | error
  lastTestAt      DateTime?
  lastTestStatus  String?
  createdAt       DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelCache ModelCache?

  @@index([userId])
  @@index([userId, isActive])
}

/// Cache daftar model per koneksi (REQ-NT-20, SDD-3.3).
///
/// Satu baris per koneksi (relasi unik). TTL diperiksa dari `fetchedAt` di
/// DATA, bukan dari timer proses, supaya cache tidak menahan model baru
/// melewati masa berlakunya setelah restart.
model ModelCache {
  id            String   @id
  connectionId  String
  modelListJson String
  fetchedAt     DateTime

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId])
}


/// Dokumen milik pengguna untuk tanya-jawab berbasis berkas (REQ-NT-54, SDD-6.1).
///
/// `filename` adalah nama asli yang sudah disanitasi, hanya untuk tampilan.
/// Berkasnya sendiri disimpan di luar webroot dengan nama acak; `storageKey`
/// adalah path relatif terhadap akar penyimpanan, bukan path absolut dan bukan
/// nama dari pengguna. Status: queued | processing | ready | failed.
model Document {
  id         String   @id
  userId     String
  filename   String
  mime       String
  sizeBytes  Int
  storageKey String
  status     String   @default("queued")
  errorCode  String?
  createdAt  DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([userId, createdAt])
  @@index([status])
}

/// Potongan teks satu dokumen (REQ-NT-55, SDD-6.1).
///
/// `page` dan `section` menyimpan metadata sumber untuk sitasi (REQ-NT-57).
/// `embedding` disimpan sebagai teks base64, bukan `Bytes`: migrasi harus
/// identik di SQLite dan PostgreSQL, dan `BLOB`/`BYTEA` ditolak
/// `scripts/check-migrations.mjs`. Vektor ditulis oleh job `document.embed`.
model DocumentChunk {
  id         String   @id
  documentId String
  ordinal    Int
  text       String
  page       Int?
  section    String?
  embedding  String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([documentId])
}

/// Folder satu tingkat untuk mengelompokkan chat (REQ-NT-35, SDD-2.2).
model Folder {
  id        String   @id
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats Chat[]

  @@index([userId])
}

/// Percakapan (REQ-NT-22, SDD-2.2). KONTRAK DIBEKUKAN di awal NT-P3.
///
/// `currentMessageId` menunjuk leaf aktif pohon pesan; harus menunjuk pesan yang ada
/// atau null (SDD-2.4). `modelRef` menyimpan id model yang dipakai chat ini, bukan
/// global (REQ-NT-19); menghapus koneksi TIDAK menghapus chat (REQ-NT-09).
model Chat {
  id               String   @id
  userId           String
  title            String
  modelRef         String?
  currentMessageId String?
  folderId         String?
  pinned           Int      @default(0) // 0 | 1
  archived         Int      @default(0) // 0 | 1
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]
  shareLinks ShareLink[]

  @@index([userId, updatedAt])
  @@index([userId, folderId])
}

/// Tautan berbagi snapshot beku publik (REQ-NT-36/37/38, SDD-2.2).
model ShareLink {
  id           String    @id
  chatId       String
  token        String    @unique
  snapshotJson String
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

/// Satu pesan dalam pohon (REQ-NT-25, SDD-2.2).
///
/// `parentId` membentuk pohon; sibling = cabang alternatif dari parent yang sama.
/// `seq` memberi urutan stabil dalam satu chat. `contentJson` menyimpan bagian
/// bertipe agar render tidak menebak.
model ChatMessage {
  id          String   @id
  chatId      String
  parentId    String?
  role        String // user | assistant | system
  contentJson String
  status      String   @default("complete") // streaming | complete | stopped | error
  usageJson   String?
  seq         Int
  createdAt   DateTime @default(now())

  chat       Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  parts      ChatMessagePart[]
  generation Generation?

  @@index([chatId, seq])
  @@index([chatId, parentId])
}

/// Bagian bertipe dari satu pesan (SDD-2.2): text | tool | image | citation.
model ChatMessagePart {
  id          String @id
  messageId   String
  kind        String
  payloadJson String
  ordinal     Int

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, ordinal])
}

/// Generasi = pekerjaan berdurasi, bukan milik koneksi HTTP (SDD-4.1).
///
/// State: queued | preparing | streaming | complete | stopped | error | indeterminate.
/// `indeterminate` TIDAK diulang otomatis — UI menawarkan coba lagi manual, supaya
/// tidak menggandakan permintaan berbayar (SDD-4.2).
model Generation {
  id                String    @id
  chatId            String
  userMessageId     String
  assistantMessageId String    @unique
  jobId             String?
  status            String    @default("queued")
  cancelRequestedAt DateTime?
  errorCode         String?
  finishReason      String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())

  assistantMessage ChatMessage       @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)
  events           GenerationEvent[]

  @@index([chatId, createdAt])
  @@index([status])
}

/// Buffer event SSE untuk pemutaran ulang setelah koneksi putus (SDD-4.5).
/// `seq` monoton per generasi; klien menyambung ulang dengan afterSeq=lastSeq.
model GenerationEvent {
  id           String   @id
  generationId String
  seq          Int
  kind         String // meta | part | usage | done | error
  payloadJson  String
  createdAt    DateTime @default(now())

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, seq])
}

/// Prompt tersimpan (REQ-NT-62/63/64). `userId` null = prompt bawaan admin.
model Prompt {
  id            String   @id
  userId        String?
  title         String
  body          String
  variablesJson String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

/// Catatan pemakaian token (REQ-NT-71, SDD-2.2).
/// `reported` = 0 bila gateway tidak melaporkan usage — jangan diisi angka karangan.
model UsageRecord {
  id               String   @id
  userId           String
  chatId           String?
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  reported         Int      @default(1) // 0 | 1
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

/// Kunci idempotensi untuk POST pesan (SDD-4.7).
/// Kunci sama + digest sama → hasil sama; digest berbeda → 409. Unik per pengguna.
model IdempotencyKey {
  id           String   @id
  userId       String
  key          String
  digest       String
  responseJson String
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

/// Sesi untuk pencabutan. Token mentah tidak pernah disimpan.
model Session {
  id            String    @id
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  userAgentHash String?
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Preferensi tampilan dan kirim (REQ-NT-70). Satu baris per pengguna.
model UserSetting {
  userId       String   @id
  theme        String   @default("system") // system | light | dark
  locale       String   @default("id")     // id | en
  fontScale    Int      @default(100)      // 90..130
  sendOnEnter  Int      @default(1)        // 1 = Enter kirim, 0 = Shift+Enter kirim
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
